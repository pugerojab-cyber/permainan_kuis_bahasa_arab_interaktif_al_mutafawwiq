        // 3. SISTEM EFEK SUARA (TONE.JS - TANPA URL EKSTERNAL)
        function playSoundEffect(type) {
            if (!soundEnabled || typeof Tone === 'undefined') return;
            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                const synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "triangle" },
                    envelope: { attack: 0.01, decay: 0.15, sustain: 0.05, release: 0.3 }
                }).toDestination();
                synth.volume.value = -8;

                const now = Tone.now();
                if (type === 'correct') {
                    // Nada ceria naik (C5 -> E5 -> G5)
                    synth.triggerAttackRelease("C5", "16n", now);
                    synth.triggerAttackRelease("E5", "16n", now + 0.08);
                    synth.triggerAttackRelease("G5", "8n", now + 0.16);
                } else if (type === 'wrong') {
                    // Nada rendah lembut (E3 -> C3)
                    synth.triggerAttackRelease("E3", "8n", now);
                    synth.triggerAttackRelease("C3", "4n", now + 0.12);
                } else if (type === 'finish') {
                    // Fanfare kemenangan sederhana
                    synth.triggerAttackRelease("C5", "16n", now);
                    synth.triggerAttackRelease("E5", "16n", now + 0.1);
                    synth.triggerAttackRelease("G5", "16n", now + 0.2);
                    synth.triggerAttackRelease("C6", "4n", now + 0.3);
                }
            } catch (e) {
                // Abaikan jika browser memblokir audio otomatis
            }
        }

