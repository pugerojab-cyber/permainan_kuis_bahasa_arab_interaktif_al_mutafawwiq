            card.classList.add('animate-pop');

            // Sembunyikan kotak feedback
            const feedbackBox = document.getElementById('feedbackBox');
            feedbackBox.classList.add('hidden');

            // Isi konten pertanyaan
            document.getElementById('questionPrompt').textContent = q.prompt;
            const arabicEl = document.getElementById('arabicText');
            arabicEl.textContent = q.arabic;

            // Sesuaikan gaya teks utama (apakah teks Arab atau teks Latin Indonesia)
            const hasArabicChars = /[\u0600-\u06FF]/.test(q.arabic);
            if (hasArabicChars) {
                arabicEl.className = "font-arab text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-950 tracking-wide py-2";
            } else {
                arabicEl.className = "text-2xl sm:text-3xl md:text-4xl font-extrabold text-emerald-950 py-3";
            }

            document.getElementById('transliterationHint').textContent = `(${q.transliteration})`;

            // Render tombol opsi jawaban
            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';

            const letters = ['A', 'B', 'C', 'D'];
            q.options.forEach((optionText, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => handleAnswer(idx);
                btn.id = `option-btn-${idx}`;

                const textStyle = q.isArabicOptions
                    ? "font-arab text-2xl sm:text-3xl font-bold text-slate-800"
                    : "text-base sm:text-lg font-bold text-slate-700";

                btn.className = "btn-game w-full p-4 rounded-2xl bg-white hover:bg-emerald-50/60 border-2 border-slate-200 border-b-slate-300 flex items-center justify-between gap-3 text-left transition cursor-pointer";
                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 font-extrabold text-xs flex items-center justify-center shrink-0 option-letter">
                        ${letters[idx]}
                    </span>
                    <span class="${textStyle} flex-grow ${q.isArabicOptions ? 'text-right pr-2' : ''}">
                        ${optionText}
                    </span>
                `;
                optionsContainer.appendChild(btn);
            });

            updateStatsUI();
        }

        // 6. MENANGANI JAWABAN PENGGUNA
        function handleAnswer(selectedIndex) {
            if (isAnswered) return;
            isAnswered = true;

            const q = questions[currentQuestionIndex];
            const isCorrect = selectedIndex === q.correctIndex;

            // Nonaktifkan semua tombol opsi & beri warna indikator
            q.options.forEach((_, idx) => {
                const btn = document.getElementById(`option-btn-${idx}`);
                btn.disabled = true;
                btn.classList.remove('hover:bg-emerald-50/60');

                if (idx === q.correctIndex) {
                    // Tandai jawaban benar dengan hijau emerald
                    btn.classList.remove('bg-white', 'border-slate-200', 'border-b-slate-300');
                    btn.classList.add('bg-emerald-50', 'border-emerald-500', 'border-b-emerald-600');
                    btn.querySelector('.option-letter').classList.replace('bg-slate-100', 'bg-emerald-600');
                    btn.querySelector('.option-letter').classList.replace('text-slate-600', 'text-white');
                } else if (idx === selectedIndex && !isCorrect) {
                    // Tandai jawaban salah yang dipilih user dengan merah rose
                    btn.classList.remove('bg-white', 'border-slate-200', 'border-b-slate-300');
                    btn.classList.add('bg-rose-50', 'border-rose-500', 'border-b-rose-600');
                    btn.querySelector('.option-letter').classList.replace('bg-slate-100', 'bg-rose-600');
                    btn.querySelector('.option-letter').classList.replace('text-slate-600', 'text-white');
                } else {
                    btn.classList.add('opacity-50');
                }
            });

            // Konfigurasi kotak feedback instan
            const feedbackBox = document.getElementById('feedbackBox');
            const feedbackIcon = document.getElementById('feedbackIcon');
            const feedbackTitle = document.getElementById('feedbackTitle');
            const feedbackExplanation = document.getElementById('feedbackExplanation');
            const nextBtn = document.getElementById('nextQuestionBtn');

            feedbackBox.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-300', 'text-emerald-950', 'bg-rose-50', 'border-rose-300', 'text-rose-950');

            if (isCorrect) {
                playSoundEffect('correct');
                streak++;
                if (streak > maxStreak) maxStreak = streak;
                correctAnswersCount++;

                // Hitung poin + bonus streak
                const bonusPoints = streak >= 2 ? (streak * 5) : 0;
                const earned = 100 + bonusPoints;
                score += earned;

                feedbackBox.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-950');
                feedbackIcon.className = "w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 text-xl font-bold mt-0.5";
                feedbackIcon.textContent = "✓";
                feedbackTitle.textContent = streak >= 2
                    ? `Ahsanta! Benar (+${earned} Poin • Streak ${streak}x 🔥)`
                    : `Mumtaz! Jawaban Benar (+${earned} Poin)`;
                nextBtn.className = "btn-game shrink-0 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 border-b-emerald-800 font-bold text-white text-sm sm:text-base shadow-md cursor-pointer";
            } else {
                playSoundEffect('wrong');
                streak = 0;
                lives = Math.max(0, lives - 1);

                // Efek getar ringan pada kartu
                const card = document.getElementById('questionCard');
                card.classList.remove('animate-pop');
                void card.offsetWidth;
                card.classList.add('animate-shake');

                feedbackBox.classList.add('bg-rose-50', 'border-rose-300', 'text-rose-950');
                feedbackIcon.className = "w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 text-xl font-bold mt-0.5";
                feedbackIcon.textContent = "✕";
                feedbackTitle.textContent = lives === 0
                    ? "Yah, Nyawa Habis!"
                    : `Kurang Tepat! Jawaban benar: ${q.options[q.correctIndex]}`;
                nextBtn.className = "btn-game shrink-0 px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-700 border-b-rose-800 font-bold text-white text-sm sm:text-base shadow-md cursor-pointer";
            }

            feedbackExplanation.textContent = q.explanation;

            // Teks tombol lanjut
            if (lives === 0 || currentQuestionIndex === questions.length - 1) {
                nextBtn.textContent = "Lihat Hasil →";
            } else {
                nextBtn.textContent = "Soal Berikutnya →";
            }

            // Catat riwayat untuk layar hasil
            userHistory.push({
                question: q.arabic,
                correctAnswer: q.options[q.correctIndex],
                userAnswer: q.options[selectedIndex],
                isCorrect: isCorrect
            });

            updateStatsUI();
        }

        function nextQuestion() {
            if (lives === 0 || currentQuestionIndex >= questions.length - 1) {
                finishGame();
            } else {
                currentQuestionIndex++;
                renderQuestion();
            }
        }

        // 7. LAYAR HASIL AKHIR (RESULT SCREEN)
        function finishGame() {
            playSoundEffect('finish');
            document.getElementById('progressBar').style.width = '100%';

            // Simpan skor tertinggi jika terpecahkan
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('alMutafawwiqHighScore', highScore.toString());
                document.getElementById('highScoreDisplay').textContent = highScore;
            }

            // Tentukan predikat nilai berbahasa Arab berdasarkan persentase benar
            const totalQuestions = questions.length;
            const accuracy = (correctAnswersCount / totalQuestions) * 100;

            let arabicGrade = "مُمْتَازٌ";
            let gradeTitle = "Mumtaz (Sempurna!)";
            let subtitle = "MasyaAllah! Penguasaan materi bahasa Arabmu sangat mengesankan.";

            if (lives === 0 && correctAnswersCount < 4) {
                arabicGrade = "حَاوِلْ مَرَّةً أُخْرَى";
                gradeTitle = "Terus Berlatih!";
                subtitle = "Jangan menyerah! Baca kembali arti kata pada ringkasan di bawah dan coba lagi.";
            } else if (accuracy >= 85) {
                arabicGrade = "مُمْتَازٌ";
                gradeTitle = "Mumtaz (Istimewa!)";
                subtitle = "Luar biasa! Kamu menjawab hampir seluruh soal dengan sangat tepat.";
            } else if (accuracy >= 65) {
                arabicGrade = "جَيِّدٌ جِدًّا";
                gradeTitle = "Jayyid Jiddan (Sangat Baik)";
                subtitle = "Kerja bagus! Sedikit lagi berlatih kamu pasti bisa meraih predikat Mumtaz.";
            } else {
                arabicGrade = "جَيِّدٌ";
                gradeTitle = "Jayyid (Baik)";
                subtitle = "Awal yang baik! Ulangi permainan untuk memperkuat hafalan kosakata dan kaidahmu.";
            }

            document.getElementById('resultArabicGrade').textContent = arabicGrade;
            document.getElementById('resultGradeTitle').textContent = gradeTitle;
            document.getElementById('resultSubtitle').textContent = subtitle;
            document.getElementById('finalScore').textContent = score;
            document.getElementById('finalCorrect').textContent = `${correctAnswersCount}/${totalQuestions}`;
            document.getElementById('finalStreak').textContent = `${maxStreak}🔥`;

            // Render daftar ringkasan jawaban
            const reviewList = document.getElementById('reviewList');
            reviewList.innerHTML = '';

            userHistory.forEach((item, index) => {
                const statusBadge = item.isCorrect
                    ? `<span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-700 font-bold text-xs">Benar</span>`
                    : `<span class="px-2 py-0.5 rounded-md bg-rose-100 text-rose-700 font-bold text-xs">Salah</span>`;

                reviewList.innerHTML += `
                    <div class="p-3 rounded-xl border ${item.isCorrect ? 'bg-emerald-50/40 border-emerald-200/70' : 'bg-rose-50/40 border-rose-200/70'} flex items-center justify-between gap-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-slate-400">#${index + 1}</span>
                                <span class="font-bold text-slate-800 text-sm truncate">${item.question}</span>
                            </div>
                            <p class="text-xs text-slate-600 mt-0.5">
                                Jawaban tepat: <strong class="text-emerald-800">${item.correctAnswer}</strong>
                                ${!item.isCorrect ? ` • Pilihanmu: <span class="text-rose-600 line-through">${item.userAnswer}</span>` : ''}
                            </p>
                        </div>
                        <div class="shrink-0">${statusBadge}</div>
                    </div>
                `;
            });

            showScreen('resultScreen');
        }
    </script>
</body>
</html>
