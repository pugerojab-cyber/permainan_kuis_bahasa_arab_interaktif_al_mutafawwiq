            // Render Nyawa (3 Hati)
            const livesContainer = document.getElementById('livesContainer');
            livesContainer.innerHTML = '';
            for (let i = 0; i < 3; i++) {
                const isAlive = i < lives;
                livesContainer.innerHTML += `
                    <svg class="w-6 h-6 transition-all duration-300 ${isAlive ? 'text-rose-500 scale-100' : 'text-slate-200 scale-90'}" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                `;
            }

            // Update Skor & Streak
            document.getElementById('scoreDisplay').textContent = score;
            document.getElementById('streakCount').textContent = streak;

            const streakBadge = document.getElementById('streakBadge');
            if (streak >= 2) {
                streakBadge.classList.add('scale-110', 'bg-amber-100', 'border-amber-400');
            } else {
                streakBadge.classList.remove('scale-110', 'bg-amber-100', 'border-amber-400');
            }

            // Update Progress Bar
            const total = questions.length;
            const progressPercent = ((currentQuestionIndex) / total) * 100;
            document.getElementById('progressBar').style.width = `${Math.max(8, progressPercent)}%`;
            document.getElementById('questionCounter').textContent = `${currentQuestionIndex + 1} / ${total}`;
        }

        function renderQuestion() {
            isAnswered = false;
            const q = questions[currentQuestionIndex];
            const card = document.getElementById('questionCard');

            // Reset animasi kartu soal
            card.classList.remove('animate-pop', 'animate-shake');
