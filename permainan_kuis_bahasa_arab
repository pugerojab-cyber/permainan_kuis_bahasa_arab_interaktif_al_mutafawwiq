<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Al-Mutafawwiq - Game Kuis Bahasa Arab Interaktif</title>
    <!-- Memuat Tailwind CSS untuk tata letak responsif dan modern -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Memuat Google Fonts: Plus Jakarta Sans (Latin) & Amiri + Noto Naskh Arabic (Arab berharakat jelas) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Memuat Tone.js untuk efek suara interaktif (benar, salah, menang) tanpa link eksternal -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        /* Pengaturan Font Utama & Font Arab */
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f4f7f5;
            background-image: radial-gradient(#10b98118 1.5px, transparent 1.5px), radial-gradient(#d9770614 1.5px, #f4f7f5 1.5px);
            background-size: 36px 36px;
            background-position: 0 0, 18px 18px;
        }

        .font-arab {
            font-family: 'Noto Naskh Arabic', 'Amiri', serif;
            direction: rtl;
            line-height: 1.9;
        }

        .font-arab-title {
            font-family: 'Amiri', serif;
            direction: rtl;
        }

        /* Animasi Kustom untuk Interaksi Game */
        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.92) translateY(10px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
            50% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        }

        .animate-pop {
            animation: popIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        .animate-glow {
            animation: pulseGlow 2s infinite;
        }

        /* Efek tombol 3D ala game edukasi (seperti Duolingo) */
        .btn-game {
            transition: all 0.15s ease;
            border-bottom-width: 4px;
        }
        .btn-game:active:not(:disabled) {
            transform: translateY(2px);
            border-bottom-width: 2px;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between selection:bg-emerald-200 selection:text-emerald-900">

    <!-- Navbar Atas Minimalis -->
    <header class="w-full bg-white/90 backdrop-blur-md border-b border-emerald-100 sticky top-0 z-30">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3 cursor-pointer" onclick="goHome()">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 flex items-center justify-center text-white shadow-md shadow-emerald-200">
                    <!-- Ikon Bintang Islami SVG -->
                    <svg class="w-6 h-6 text-amber-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2L14.8 8.5L21.8 9.2L16.5 13.9L18.1 20.8L12 17.1L5.9 20.8L7.5 13.9L2.2 9.2L9.2 8.5L12 2Z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg sm:text-xl text-emerald-950 tracking-tight leading-none">
                        Al-Mutafawwiq
                    </h1>
                    <p class="text-xs text-emerald-600 font-medium mt-0.5">Kuis Interaktif Bahasa Arab</p>
                </div>
            </div>

            <!-- Tombol Kontrol Suara & Kembali -->
            <div class="flex items-center gap-2">
                <button id="soundToggleBtn" onclick="toggleSound()" title="Suara Efek Game" class="p-2.5 rounded-xl bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 transition">
                    <!-- Ikon Sound On -->
                    <svg id="soundOnIcon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
                    </svg>
                    <!-- Ikon Sound Off (Tersembunyi awalnya) -->
                    <svg id="soundOffIcon" class="w-5 h-5 hidden text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Kontainer Utama Aplikasi -->
    <main class="flex-grow flex items-center justify-center p-4 sm:p-6">
        <div class="w-full max-w-3xl">

            <!-- ========================================== -->
            <!-- 1. LAYAR AWAL (START SCREEN)               -->
            <!-- ========================================== -->
            <section id="startScreen" class="animate-pop">
                <!-- Banner Sambutan -->
                <div class="bg-gradient-to-br from-emerald-800 via-emerald-700 to-teal-800 rounded-3xl p-6 sm:p-10 text-white shadow-xl shadow-emerald-900/10 relative overflow-hidden mb-6">
                    <!-- Ornamen Dekoratif Latar -->
                    <div class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-amber-400/10 blur-xl pointer-events-none"></div>
                    <div class="absolute -left-10 -bottom-10 w-40 h-40 rounded-full bg-emerald-400/15 blur-xl pointer-events-none"></div>

                    <div class="relative z-10 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
                        <div>
                            <span class="inline-block px-3 py-1 rounded-full bg-amber-400/20 border border-amber-300/30 text-amber-200 text-xs font-semibold tracking-wider uppercase mb-3">
                                Belajar Sambil Bermain
                            </span>
                            <p class="font-arab-title text-3xl sm:text-4xl text-amber-300 mb-2">أَهْلًا وَسَهْلًا بِكُمْ</p>
                            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-2">
                                Tantang Kemampuan Bahasa Arabmu!
                            </h2>
                            <p class="text-emerald-100 text-sm sm:text-base max-w-lg leading-relaxed">
                                Pilih kategori materi di bawah ini, kumpulkan poin sebanyak-banyaknya, pertahankan 3 nyawa, dan raih predikat <strong class="text-amber-300">Mumtaz (مُمْتَازٌ)</strong>!
                            </p>
                        </div>
                        <div class="shrink-0 bg-white/10 backdrop-blur-sm border border-white/20 p-4 rounded-2xl text-center min-w-[140px]">
                            <div class="text-xs text-emerald-200 uppercase font-semibold">Skor Tertinggi</div>
                            <div id="highScoreDisplay" class="text-3xl font-black text-amber-300 mt-1">0</div>
                            <div class="text-[11px] text-emerald-100 mt-1">Poin Terbaik</div>
                        </div>
                    </div>
                </div>

                <!-- Pilihan Kategori Materi -->
                <div class="mb-3 flex items-center justify-between px-1">
                    <h3 class="font-bold text-slate-700 text-base sm:text-lg">Pilih Kategori Permainan:</h3>
                    <span class="text-xs text-slate-500 font-medium">8 Soal per Sesi</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Kategori 1: Mufradat -->
                    <button onclick="startGame('mufradat')" class="btn-game group text-left bg-white hover:bg-emerald-50/70 border-2 border-slate-200 border-b-emerald-600 rounded-2xl p-5 shadow-sm hover:shadow-md flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-arab text-2xl font-bold group-hover:scale-110 transition">
                                    مُفْرَدَات
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-emerald-100/80 text-emerald-800 text-xs font-bold">
                                    Level 1 • Dasar
                                </span>
                            </div>
                            <h4 class="font-extrabold text-lg text-slate-800 group-hover:text-emerald-800">Kosakata Sehari-hari</h4>
                            <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
                                Mengenal nama benda di sekitar, anggota tubuh, warna, dan aktivitas harian.
                            </p>
                        </div>
                        <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-emerald-700 font-bold text-sm">
                            <span>Mulai Main</span>
                            <span class="group-hover:translate-x-1 transition">→</span>
                        </div>
                    </button>

                    <!-- Kategori 2: Muhadatsah -->
                    <button onclick="startGame('muhadatsah')" class="btn-game group text-left bg-white hover:bg-amber-50/60 border-2 border-slate-200 border-b-amber-500 rounded-2xl p-5 shadow-sm hover:shadow-md flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-arab text-2xl font-bold group-hover:scale-110 transition">
                                    مُحَادَثَة
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-amber-100/80 text-amber-800 text-xs font-bold">
                                    Level 2 • Dialog
                                </span>
                            </div>
                            <h4 class="font-extrabold text-lg text-slate-800 group-hover:text-amber-800">Percakapan Dasar</h4>
                            <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
                                Melengkapi kalimat sapaan, perkenalan diri, menanyakan kabar, dan ungkapan sopan.
                            </p>
                        </div>
                        <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-amber-700 font-bold text-sm">
                            <span>Mulai Main</span>
                            <span class="group-hover:translate-x-1 transition">→</span>
                        </div>
                    </button>

                    <!-- Kategori 3: Tata Bahasa (Qawaid) -->
                    <button onclick="startGame('qawaid')" class="btn-game group text-left bg-white hover:bg-teal-50/70 border-2 border-slate-200 border-b-teal-600 rounded-2xl p-5 shadow-sm hover:shadow-md flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center font-arab text-2xl font-bold group-hover:scale-110 transition">
                                    قَوَاعِد
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-teal-100/80 text-teal-800 text-xs font-bold">
                                    Level 3 • Nahwu
                                </span>
                            </div>
                            <h4 class="font-extrabold text-lg text-slate-800 group-hover:text-teal-800">Dasar Tata Bahasa</h4>
                            <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
                                Membedakan Isim (kata benda), Fi'il (kata kerja), Huruf, serta kata tunjuk (Isyarah).
                            </p>
                        </div>
                        <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-teal-700 font-bold text-sm">
                            <span>Mulai Main</span>
                            <span class="group-hover:translate-x-1 transition">→</span>
                        </div>
                    </button>
                </div>
            </section>

            <!-- ========================================== -->
            <!-- 2. LAYAR PERMAINAN KUIS (QUIZ SCREEN)      -->
            <!-- ========================================== -->
            <section id="quizScreen" class="hidden">
                <!-- Bar Status Game: Nyawa, Progress Bar, Skor & Streak -->
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 mb-5">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                        <!-- Tombol Keluar & Nyawa (Hearts) -->
                        <div class="flex items-center gap-3">
                            <button onclick="confirmQuit()" class="text-slate-400 hover:text-rose-500 p-1.5 rounded-lg hover:bg-rose-50 transition" title="Keluar ke Menu">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                            <div id="livesContainer" class="flex items-center gap-1" aria-label="Sisa Nyawa">
                                <!-- Ikon hati dirender lewat JS -->
                            </div>
                        </div>

                        <!-- Indikator Kategori -->
                        <span id="categoryBadge" class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
                            Kosakata
                        </span>

                        <!-- Streak & Skor -->
                        <div class="flex items-center gap-3">
                            <div id="streakBadge" class="flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-xs font-extrabold transition-transform">
                                <span>🔥</span>
                                <span id="streakCount">0</span>
                            </div>
                            <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-600 text-white text-xs sm:text-sm font-extrabold shadow-sm">
                                <span>★</span>
                                <span id="scoreDisplay">0</span>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar Soal -->
                    <div class="flex items-center gap-3">
                        <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden p-0.5 border border-slate-200/60">
                            <div id="progressBar" class="h-full bg-gradient-to-r from-emerald-500 to-amber-400 rounded-full transition-all duration-500 ease-out" style="width: 12.5%"></div>
                        </div>
                        <span id="questionCounter" class="text-xs font-bold text-slate-500 whitespace-nowrap">1 / 8</span>
                    </div>
                </div>

                <!-- Kartu Pertanyaan Utama -->
                <div id="questionCard" class="bg-white rounded-3xl p-6 sm:p-8 shadow-md border border-slate-200/80 animate-pop">
                    <!-- Instruksi Soal -->
                    <p id="questionPrompt" class="text-sm sm:text-base font-semibold text-slate-500 text-center mb-4">
                        Apa arti dari kata bahasa Arab berikut?
                    </p>

                    <!-- Kotak Teks Arab Besar & Jelas -->
                    <div class="bg-gradient-to-b from-emerald-50/70 to-amber-50/40 border border-emerald-100 rounded-2xl p-6 sm:p-8 mb-6 text-center relative">
                        <div id="arabicText" class="font-arab text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-950 tracking-wide py-2">
                            كِتَابٌ
                        </div>
                        <div id="transliterationHint" class="text-xs sm:text-sm text-emerald-700/80 font-medium mt-2">
                            (Kitaabun)
                        </div>
                    </div>

                    <!-- Pilihan Jawaban (Grid 2 Kolom di Desktop, 1 Kolom di HP) -->
                    <div id="optionsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <!-- Tombol Opsi dirender oleh JavaScript -->
                    </div>

                    <!-- Panel Umpan Balik Instan (Muncul setelah user menjawab) -->
                    <div id="feedbackBox" class="hidden mt-6 rounded-2xl p-4 sm:p-5 border-2 transition-all">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="flex items-start gap-3">
                                <div id="feedbackIcon" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-xl font-bold mt-0.5">
                                    ✓
                                </div>
                                <div>
                                    <h4 id="feedbackTitle" class="font-extrabold text-base sm:text-lg">
                                        Mumtaz! Jawaban Benar
                                    </h4>
                                    <p id="feedbackExplanation" class="text-xs sm:text-sm mt-1 leading-relaxed">
                                        Penjelasan arti kata muncul di sini.
                                    </p>
                                </div>
                            </div>
                            <button id="nextQuestionBtn" onclick="nextQuestion()" class="btn-game shrink-0 px-6 py-3 rounded-xl font-bold text-white text-sm sm:text-base shadow-md cursor-pointer">
                                Lanjut →
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ========================================== -->
            <!-- 3. LAYAR HASIL AKHIR (RESULT SCREEN)       -->
            <!-- ========================================== -->
            <section id="resultScreen" class="hidden animate-pop">
                <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-200/80 text-center">
                    <!-- Lencana Predikat -->
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-to-br from-amber-400 to-amber-500 text-white shadow-lg shadow-amber-200 mb-4">
                        <svg class="w-11 h-11" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                        </svg>
                    </div>

                    <p id="resultArabicGrade" class="font-arab-title text-4xl sm:text-5xl font-bold text-emerald-700 mb-1">
                        مُمْتَازٌ
                    </p>
                    <h2 id="resultGradeTitle" class="text-2xl sm:text-3xl font-extrabold text-slate-800">
                        Mumtaz (Sempurna!)
                    </h2>
                    <p id="resultSubtitle" class="text-sm sm:text-base text-slate-500 max-w-md mx-auto mt-2">
                        Luar biasa! Kamu menguasai materi bahasa Arab pada kategori ini dengan sangat baik.
                    </p>

                    <!-- Kartu Statistik Skor -->
                    <div class="grid grid-cols-3 gap-3 sm:gap-4 my-7 max-w-lg mx-auto">
                        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-3.5">
                            <div class="text-xs font-semibold text-emerald-700">Total Skor</div>
                            <div id="finalScore" class="text-2xl sm:text-3xl font-black text-emerald-900 mt-1">0</div>
                        </div>
                        <div class="bg-amber-50 border border-amber-100 rounded-2xl p-3.5">
                            <div class="text-xs font-semibold text-amber-700">Jawaban Benar</div>
                            <div id="finalCorrect" class="text-2xl sm:text-3xl font-black text-amber-900 mt-1">0/8</div>
                        </div>
                        <div class="bg-teal-50 border border-teal-100 rounded-2xl p-3.5">
                            <div class="text-xs font-semibold text-teal-700">Max Streak</div>
                            <div id="finalStreak" class="text-2xl sm:text-3xl font-black text-teal-900 mt-1">0🔥</div>
                        </div>
                    </div>

                    <!-- Ringkasan Review Jawaban -->
                    <div class="text-left max-w-xl mx-auto mb-7">
                        <h3 class="font-bold text-slate-700 text-sm uppercase tracking-wider mb-3 flex items-center gap-2">
                            <span>Ringkasan Pembelajaran</span>
                            <span class="h-px bg-slate-200 flex-grow"></span>
                        </h3>
                        <div id="reviewList" class="space-y-2.5 max-h-60 overflow-y-auto pr-1">
                            <!-- Daftar ringkasan soal & jawaban dirender via JS -->
                        </div>
                    </div>

                    <!-- Tombol Aksi Akhir -->
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                        <button onclick="replayCategory()" class="btn-game w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 border-b-emerald-800 text-white font-bold text-base shadow-md">
                            ↻ Main Lagi Kategori Ini
                        </button>
                        <button onclick="goHome()" class="btn-game w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-slate-100 hover:bg-slate-200 border-b-slate-300 text-slate-700 font-bold text-base">
                            Pilih Kategori Lain
                        </button>
                    </div>
                </div>
            </section>

        </div>
    </main>

    <!-- Modal Konfirmasi Keluar Kustom (Pengganti confirm() bawaan browser) -->
    <div id="quitModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl animate-pop">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl font-bold">
                !
            </div>
            <h3 class="text-lg font-extrabold text-slate-800">Keluar dari Permainan?</h3>
            <p class="text-sm text-slate-500 mt-1 mb-5">Progres kuis saat ini tidak akan tersimpan jika kamu kembali ke menu utama.</p>
            <div class="flex gap-3">
                <button onclick="closeQuitModal()" class="flex-1 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 font-bold text-slate-700 text-sm">
                    Lanjut Main
                </button>
                <button onclick="confirmGoHome()" class="flex-1 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 font-bold text-white text-sm">
                    Ya, Keluar
                </button>
            </div>
        </div>
    </div>

    <!-- Footer Sederhana -->
    <footer class="text-center py-4 text-xs text-slate-400">
        Media Pembelajaran Bahasa Arab Interaktif • Dibuat dengan Semangat Belajar
    </footer>

    <!-- ========================================== -->
    <!-- LOGIKA JAVASCRIPT GAME KUIS                -->
    <!-- ========================================== -->
    <script>
        // 1. BANK SOAL BERDASARKAN KATEGORI
        const quizDatabase = {
            mufradat: {
                title: "Kosakata Sehari-hari (Mufradat)",
                questions: [
                    {
                        prompt: "Apa arti dari kata benda berikut?",
                        arabic: "كِتَابٌ",
                        transliteration: "Kitaabun",
                        options: ["Buku", "Pena", "Meja", "Tas"],
                        correctIndex: 0,
                        isArabicOptions: false,
                        explanation: "كِتَابٌ (Kitaabun) artinya 'Buku'. Contoh jamaknya adalah كُتُبٌ (Kutubun)."
                    },
                    {
                        prompt: "Pilih bahasa Arab yang tepat untuk kata 'Sekolah':",
                        arabic: "Sekolah",
                        transliteration: "Tempat menuntut ilmu",
                        options: ["مَدْرَسَةٌ", "مَسْجِدٌ", "مَكْتَبَةٌ", "بَيْتٌ"],
                        correctIndex: 0,
                        isArabicOptions: true,
                        explanation: "مَدْرَسَةٌ (Madrasatun) artinya Sekolah. Sedangkan مَسْجِدٌ artinya Masjid dan بَيْتٌ artinya Rumah."
