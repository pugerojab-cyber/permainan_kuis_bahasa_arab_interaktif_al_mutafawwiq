        // 5. MEMULAI & MERENDER KUIS
        function shuffleArray(array) {
            const cloned = [...array];
            for (let i = cloned.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [cloned[i], cloned[j]] = [cloned[j], cloned[i]];
            }
            return cloned;
        }

        function startGame(categoryKey) {
            currentCategoryKey = categoryKey;
            const categoryData = quizDatabase[categoryKey];

            // Acak urutan soal agar permainan selalu segar
            questions = shuffleArray(categoryData.questions);
            currentQuestionIndex = 0;
            score = 0;
            lives = 3;
            streak = 0;
            maxStreak = 0;
            correctAnswersCount = 0;
            userHistory = [];

            document.getElementById('categoryBadge').textContent = categoryData.title;
            updateStatsUI();
            showScreen('quizScreen');
            renderQuestion();
        }

